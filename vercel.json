{
    "buildCommand": "npm run build --workspace=@workspace/realty-pro",
    "outputDirectory": "artifacts/realty-pro/dist/public",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}